### Jira
# Jira Cloud example: https://your-domain.atlassian.net
JIRA_URL=
# Jira Cloud: your email
JIRA_USERNAME=
# Jira Cloud: API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_PASSWORD=

### Vertex AI (Google Cloud)
PROJECT_ID=
# Default: us-central1
LOCATION=us-central1
# Default: gemini-3.1-flash-lite-preview
VERTEX_MODEL=gemini-3.1-flash-lite-preview

### Optional toggles
# Force description format: true uses Atlassian Document Format, false uses plain text.
# If unset, Jira Cloud (.atlassian.net) defaults to ADF and Server/Data Center defaults to plain text.
# JIRA_USE_ADF=true

# pro | snarky
JIRAAI_TONE=pro

# Max characters to ingest from PDFs
JIRAAI_ATTACHMENT_MAX_CHARS=8000
